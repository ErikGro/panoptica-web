// Let the deploy account (webhook-user) restart ONLY panoptica-server.service.
// The unit is root-owned and runs as the non-root `panoptica` user, so this grants nothing
// beyond a restart of that one service (koflerlab server wiki, "Service Accounts and Privileges").
// Return YES, not AUTH_*, because webhook-user has no interactive session to authenticate against.
polkit.addRule(function(action, subject) {
    if (action.id === "org.freedesktop.systemd1.manage-units" &&
        action.lookup("unit") === "panoptica-server.service" &&
        subject.user === "webhook-user") {
        return polkit.Result.YES;
    }
});
